# These values are public browser configuration. Never place production secrets here.
VUE_APP_TITLE=智能家居 IoT 实训平台
VUE_APP_BASE_API=/dev-api
VUE_APP_SERVER_API_URL=http://127.0.0.1:8080
# Local MQTT / EMQX development endpoints only.
VUE_APP_EMQX_SERVER_URL=ws://127.0.0.1:8083/mqtt
VUE_APP_EMQX_API_URL=http://127.0.0.1:18083
# Optional local-only EMQX management login; values are exposed to the browser.
VUE_APP_EMQX_API_USER_NAME=
VUE_APP_EMQX_API_PASSWORD=
# Empty means the course-platform WebSocket is not connected automatically.
VUE_APP_IOT_WEBSOCKET_URL=
# Optional public browser map key; restrict its allowed domains if configured.
VUE_APP_BAI_DU_AK=
